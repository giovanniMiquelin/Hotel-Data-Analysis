            <column caption='LEAD TIME BY WEEK' datatype='string' name='[Calculation_1770804373225473]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [lead_time] &lt;= 7 THEN &apos;01. 0-7 days&apos;&#13;&#10;ELSEIF [lead_time] &lt;= 14 THEN &apos;02. 8-14 days&apos;&#13;&#10;ELSEIF [lead_time] &lt;= 30 THEN &apos;03. 15-30 days&apos;&#13;&#10;ELSEIF [lead_time] &lt;= 60 THEN &apos;04. 31-60 days&apos;&#13;&#10;ELSEIF [lead_time] &lt;= 90 THEN &apos;05. 61-90 days&apos;&#13;&#10;ELSEIF [lead_time] &lt;= 100 THEN &apos;06. 91-100 days&apos;&#13;&#10;ELSEIF [lead_time] &lt;= 120 THEN &apos;07. 101-120 days&apos;&#13;&#10;ELSEIF [lead_time] &lt;= 150 THEN &apos;08. 121-150 days&apos;&#13;&#10;ELSEIF [lead_time] &lt;= 180 THEN &apos;09. 151-180 days&apos;&#13;&#10;ELSEIF [lead_time] &lt;= 240 THEN &apos;10. 181-240 days&apos;&#13;&#10;ELSEIF [lead_time] &lt;= 300 THEN &apos;11. 241-300 days&apos;&#13;&#10;ELSEIF [lead_time] &lt;= 360 THEN &apos;12. 301-360 days&apos;&#13;&#10;ELSE &apos;13. 360+ days&apos;&#13;&#10;END' />
            </column>
            <column caption='Is Canceled' datatype='integer' name='[is_canceled]' role='measure' type='quantitative' />
            <column caption='Lead Time' datatype='integer' name='[lead_time]' role='measure' type='quantitative' />
