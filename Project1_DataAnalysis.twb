      <table>
        <view>
          <datasources>
            <datasource caption='hotel_bookings' name='federated.1ykdmtr120z1g81ddxyr30jnug67' />
          </datasources>
          <datasource-dependencies datasource='federated.1ykdmtr120z1g81ddxyr30jnug67'>
            <column caption='Is Reserved' datatype='integer' name='[Calculation_1770804353814528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_canceled] = 1 THEN 0&#13;&#10;ELSE 1&#13;&#10;END' />
